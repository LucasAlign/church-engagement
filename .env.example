# Replit provides DATABASE_URL automatically after a PostgreSQL database is added.
DATABASE_URL=postgresql://user:password@localhost:5432/flock

# Optional frontend override for a separately hosted API.
VITE_API_URL=http://127.0.0.1:3000/api

# Optional: force offline/demo mode for local QA.
VITE_DEMO_MODE=false

# Development defaults to no authentication. Production requires an explicit mode.
# Use "proxy" when a trusted reverse proxy supplies AUTH_USER_HEADER, or "bearer"
# for machine-to-machine access with an API_AUTH_TOKEN of at least 32 characters.
AUTH_MODE=none
AUTH_USER_HEADER=x-authenticated-user-id
# API_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Prefer a CA-valid database certificate. Enable only for a database provider that
# cannot supply one.
DATABASE_SSL_ALLOW_INVALID_CERT=false
