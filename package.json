{
  "name": "keyfam1-church-engagement",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_DEMO_MODE=true vite",
    "dev:client": "cross-env VITE_API_URL=/api vite",
    "dev:server": "node --env-file-if-exists=.env.local --watch server/index.js",
    "dev:full": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "db:wipe": "node --env-file-if-exists=.env.local server/wipe-data.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:data": "node test-data.mjs",
    "test:server": "node test-server.mjs",
    "test:transfer": "node test-transfer.mjs",
    "test": "npm run test:data && npm run test:server && npm run test:transfer",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "playwright": "^1.62.1",
    "puppeteer": "^25.7.0",
    "vite": "^8.2.1"
  }
}
